{
  // Un unico Worker: serve i file statici di Angular e l'API sotto /api.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "magazzino",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Output della build Angular (npm run build:web)
    "directory": "../web/dist/web/browser",
    "binding": "ASSETS",
    // Le rotte non trovate tornano a index.html (routing lato client)
    "not_found_handling": "single-page-application",
    // Solo /api/* passa dal codice del Worker; il resto è servito come asset
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magazzino",
      // Segnaposto: va sostituito con l'id reale dopo `wrangler d1 create magazzino`.
      // In locale (wrangler dev / --local) funziona anche così.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}

